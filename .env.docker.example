# ============================================================
# Self-hosting with Docker Compose
# ============================================================
#   cp .env.docker.example .env
#   docker compose up -d
#
# Only the first three are required to get running.

# --- Database (compose creates it; just pick a password) ---
POSTGRES_USER=vibepsa
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=vibepsa

# --- Secrets ---
# Encrypts stored API keys and SMTP passwords.
#   openssl rand -hex 32
# Keep it safe: lose it and those stored secrets cannot be decrypted.
AI_ENCRYPTION_KEY=

# --- Where this instance lives ---
# Must be a public URL for Microsoft 365 email webhooks to reach you.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Authentication ---
# VibePSA uses Supabase Auth for sign-in, password reset and two-factor.
# A free Supabase project is enough; only the auth service is used, your data
# stays in the Postgres above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mode ---
# self_hosted (default) — no billing, no plan limits, everything unlocked.
# hosted — the commercial service. Not what you want here.
DEPLOYMENT_MODE=self_hosted

# Seed demo data on first start. Set false once you are live.
RUN_SEED=true

# --- Optional ---
# Restricted read-only role for the AI's SQL tool. See docs/SECURITY-AI.md.
# AI_DATABASE_URL=
