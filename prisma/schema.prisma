}

model QuoteTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  items       Json     @default("[]") // Template line items
  notes       String?
  terms       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("quote_templates")
}

model EmailLog {
  id           String   @id @default(cuid())
  tenantId     String
  quoteId      String?
  recipient    String
  subject      String
  status       String   @default("sent") // sent, delivered, failed, bounced
  errorMessage String?
  sentAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("email_logs")
}

model AccountingInvoice {
  id                    String    @id @default(cuid())
  tenantId              String
  quoteId               String?
  invoiceId             String?
  platform              String // xero, quickbooks
  externalInvoiceId     String?
  externalInvoiceNumber String?
  externalUrl           String?
  status                String    @default("pending") // pending, synced, error
  errorMessage          String?
  totalAmount           Float?
  currency              String?
  syncedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("accounting_invoices")
}

// ============================================================
// ASSETS / CONFIGURATION ITEMS
// ============================================================

model Asset {
  id             String    @id @default(cuid())
  tenantId       String
  companyId      String?
  siteId         String?
  contactId      String?
  name           String
  assetTag       String?
  serialNumber   String?
  type           String    @default("device") // device, server, network, software, peripheral, other
  manufacturer   String?
  model          String?
  status         String    @default("active") // active, inactive, retired, in_repair, lost
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  notes          String?
  rmmSource      String? // ninja, datto, manual
  rmmExternalId  String? // ID in the RMM system
  customData     Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([tenantId])
  @@index([companyId])
  @@index([rmmSource, rmmExternalId])
  @@map("assets")
}

/// One-time sign-in links for the client portal.
///
/// Only a hash is stored: a leaked database row cannot be replayed as a login.
/// Rows are single-use and short-lived, and old ones are pruned when a contact
/// requests a new link.
model PortalLoginToken {
  id        String    @id @default(cuid())
  contactId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Where the request came from, for an audit trail on a public endpoint.
  requestIp String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([expiresAt])
  @@map("portal_login_tokens")
}

// ============================================================
// BILLING - hosted service only
// ============================================================
// Nothing here is used when DEPLOYMENT_MODE=self_hosted. A self-hoster gets
// every feature with no subscription row and no limits, and should never see
// billing UI at all.

/// The hosted plan a tenant is on. Flat monthly per MSP, tiered by size - 
/// deliberately not per seat, so growing a team never costs more.
model Plan {
  id           String  @id @default(cuid())
  /// Stable key used in code: starter, growth, scale.
  key          String  @unique
  name         String
  description  String?
  /// Pence per month, to avoid floating point on money.
  priceMonthly Int
  priceYearly  Int?
  currency     String  @default("GBP")

  /// Soft limits. Null means unlimited. Enforced only when hosted.
  maxUsers     Int?
  maxCompanies Int?
  maxTickets   Int?

  /// Identifier at the payment provider (Paddle price id).
  providerPriceId       String?
  providerPriceIdYearly String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  subscriptions Subscription[]

  @@map("plans")
}

/// A tenant's subscription to the hosted service.
///
/// The payment provider is the source of truth for status; this is a local
/// mirror kept current by webhook so that authorisation never depends on an
/// outbound API call succeeding.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  planId   String

  /// trialing, active, past_due, paused, cancelled
  status String @default("trialing")

  /// Paddle (merchant of record - it handles VAT and sales tax liability).
  provider               String  @default("paddle")
  providerCustomerId     String?
  providerSubscriptionId String? @unique

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelAt         DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

/// Every billing webhook received, stored before it is acted on.
///
/// Providers retry, so events must be idempotent - providerEventId is unique
/// and a replay is recognised rather than double-applied. It is also the only
/// record of what the provider actually said when a charge is disputed.
model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  tenantId        String?
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([eventType])
  @@map("billing_events")
}

/// One-time password-reset links.
///
/// Only a hash is stored, so a leaked row cannot be replayed. Single use and
/// short-lived; requesting a new one retires any outstanding link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// CRM configuration
// ============================================================

/// A stage in the sales pipeline. Defined per tenant so each MSP can run its
/// own process, and reported on as a funnel.
model PipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  color       String   @default("#3b82f6")
  /// Default probability applied to an opportunity entering this stage.
  probability Int      @default(0)
  /// Terminal stages. An opportunity in one of these is out of the pipeline.
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("pipeline_stages")
}

/// Why an opportunity was won or lost. Optional: a tenant that defines none
/// simply never sees the field.
model WinLossReason {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// "win" or "loss".
  type      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([tenantId, type, name])
  @@index([tenantId])
  @@map("win_loss_reasons")
}

/// A note on an opportunity. Stage changes write a system note here, so the
/// history of a deal reads in one place.
model OpportunityNote {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  userId        String?
  content       String
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?       @relation("OpportunityNoteAuthor", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([opportunityId])
  @@map("opportunity_notes")
}

/// One block of prepaid hours.
///
/// A contract can have many: the one-off block it was sold with, a block raised
/// each month, a top-up when the balance ran low, and hours carried over from
/// the period before. Keeping them apart is what makes carry-over, expiry and
/// "what did we actually bill them" answerable.
model ContractHourBlock {
  id         String @id @default(cuid())
  tenantId   String
  contractId String

  /// How the block came about: one_off, monthly, top_up or carry_over.
  source     String @default("one_off")
  hours      Float
  hoursUsed  Float  @default(0)
  /// Rate the hours were sold at, and the resulting charge. A carried over
  /// block is worth nothing new, so its amount is zero.
  hourlyRate Float?
  amount     Float  @default(0)

  /// The period a monthly block belongs to. Null on a one-off block.
  periodStart DateTime?
  periodEnd   DateTime?

  /// Set once the block has been put on an invoice, so it is not billed twice.
  invoiceId     String?
  /// Carried-over hours point back at the block they came from.
  carriedFromId String?
  /// Free text, for example why a top-up was agreed.
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@map("contract_hour_blocks")
}

/// What a client contact may see and do in the portal.
///
/// Scopes are deliberately coarse: "none", "own" (records where they are the
/// contact) or "company" (everything their company has). Anything finer is a
/// permissions system nobody will maintain.
model PortalRole {
  id       String @id @default(cuid())
  tenantId String
  name     String

  /// "none" | "own" | "company"
  ticketScope  String @default("own")
  quoteScope   String @default("none")
  projectScope String @default("none")
  invoiceScope String @default("none")
  /// The Reports area, which is where the prepaid hours report lives.
  reportScope  String @default("none")

  /// Prepaid hours remaining, for clients who buy blocks.
  showBlocks Boolean @default(false)

  /// Raising and replying to tickets. Everything else in the portal is read
  /// only: a client never edits a quote, a project or an invoice.
  canCreateTickets Boolean @default(true)
  canReplyTickets  Boolean @default(true)

  /// Given to a contact who has no role of their own.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("portal_roles")
}

// ============================================================
// INBOUND PAYMENT WEBHOOKS
// ============================================================

/// An endpoint a payment provider calls when money arrives, which marks the
/// matching invoice paid. Inbound, so the opposite direction to Webhook.
model PaymentWebhook {
  id       String @id @default(cuid())
  tenantId String
  name     String

  /// The public half of the URL: /api/webhooks/payments/<publicId>.
  /// Not a secret on its own; the shared secret is what authenticates a call.
  publicId String @unique

  /// SHA-256 of the shared secret. The secret itself is shown once, when the
  /// endpoint is created, and is never stored anywhere in readable form.
  secretHash String

  /// Which provider posts here, for the payment's method field.
  provider String  @default("generic") // generic, stripe, gocardless, xero, paypal
  isActive Boolean @default(true)

  lastReceivedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events PaymentWebhookEvent[]

  @@index([tenantId])
  @@map("payment_webhooks")
}

/// Every call received, accepted or not. Without this an inbound webhook is
/// impossible to debug, because the sender's logs are the only other record.
model PaymentWebhookEvent {
  id        String  @id @default(cuid())
  tenantId  String
  webhookId String
  payload   Json
  success   Boolean @default(false)
  /// Why it was rejected, or what it did.
  message   String?
  invoiceId String?
  amount    Float?

  createdAt DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook PaymentWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([webhookId])
  @@map("payment_webhook_events")
}
